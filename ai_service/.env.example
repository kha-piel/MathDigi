# Copy to ai_service/.env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
# Used only to verify the caller's Supabase login token (anon key, not service_role).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Comma-separated list of web origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
